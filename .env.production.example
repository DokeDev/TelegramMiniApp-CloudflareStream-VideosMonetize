APP_ENV=production
HOST=0.0.0.0
PORT=18763
TRUST_PROXY=true
BODY_LIMIT_BYTES=1048576
FRONTEND_ORIGIN=https://your-domain.example
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=240
PUBLIC_BASE_URL=https://your-domain.example
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=/app/frontend/dist

ADMIN_USERNAME=change-this-admin-username
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-long-random-session-secret
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_SESSION_BINDING=user-agent
ADMIN_LOGIN_MAX_ATTEMPTS=8
ADMIN_LOGIN_WINDOW_SECONDS=600
ADMIN_LOGIN_LOCK_SECONDS=900
ADMIN_ALLOW_PASSWORD_HEADER=false

MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password
DATABASE_URL=mysql://tgwebapp:change-this-mysql-password@mysql:3306/tgwebapp

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-this-random-secret
# 外部服务端调用积分充值接口时使用，不能暴露到浏览器前端。
EXTERNAL_RECHARGE_SECRET=change-this-external-recharge-secret
DEV_TELEGRAM_USER_ID=10001
DEV_TELEGRAM_USERNAME=devbuyer

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
TOKEN_TTL_SECONDS=900
DEMO_CLOUDFLARE_VIDEO_UID=

OFFICIAL_WATERMARK_TEXT=Official
VITE_API_BASE_URL=
